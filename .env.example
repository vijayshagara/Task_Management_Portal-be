# ============================================
# DATABASE CONFIGURATION (REQUIRED)
# ============================================
# For Supabase (Cloud):
# DB_NAME=postgres
# DB_USER=postgres
# DB_PASSWORD=<your-supabase-password>
# DB_HOST=db.<project-id>.supabase.co
# DB_PORT=5432
# DB_SSL=true

# For Local PostgreSQL:
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_SSL=false

# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=5000
NODE_ENV=development

# ============================================
# JWT CONFIGURATION (REQUIRED)
# ============================================
JWT_SECRET=super-strong-secret-key-change-this-in-production
JWT_EXPIRES_IN=2h

# ============================================
# GOOGLE OAUTH CONFIGURATION (OPTIONAL)
# ============================================
# To generate these:
# 1. Go to https://console.cloud.google.com/
# 2. Create a new project
# 3. Enable Google Calendar API
# 4. Create OAuth 2.0 credentials (Web application)
# 5. Add authorized redirect URI: http://localhost:5000/oauth2callback
#
# Then visit: http://localhost:5000/generate-token
# And follow the prompts to get the GOOGLE_REFRESH_TOKEN

GOOGLE_CLIENT_ID=your-client-id-here
GOOGLE_CLIENT_SECRET=your-client-secret-here
GOOGLE_REDIRECT_URI=http://localhost:5000/oauth2callback
GOOGLE_REFRESH_TOKEN=your-refresh-token-here

# ============================================
# EMAIL CONFIGURATION (OPTIONAL)
# ============================================
# Use Gmail App Password (not your main password)
# Enable 2FA on your Gmail account, then generate an App Password
# https://myaccount.google.com/apppasswords

EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# ============================================
# REDIS CONFIGURATION (OPTIONAL)
# ============================================
# For Upstash Redis or local Redis
REDIS_URL=rediss://default:password@host:port

# ============================================
# MONGODB ATLAS (OPTIONAL — cow images via GridFS)
# ============================================
# 1. Create a free cluster at https://cloud.mongodb.com
# 2. Add a database user and allow network access (0.0.0.0/0 for Vercel)
# 3. Copy the connection string below
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/cattle_farm
